<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pw_bg">

    <!-- Hero 顶部渐变区：圆角下沿，避开状态栏 -->
    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pw_hero_h"
        android:background="@drawable/pw_hero_gradient"
        android:orientation="vertical"
        android:paddingLeft="@dimen/pw_pad"
        android:paddingRight="@dimen/pw_pad"
        android:paddingTop="@dimen/vs_60"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_90"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="left|center_vertical"
                android:text="@string/app_name"
                android:textAlignment="gravity"
                android:textColor="@color/pw_card"
                android:textSize="@dimen/pw_ts_title"
                android:textStyle="bold" />

            <View
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_0"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:gravity="right|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="gravity"
                android:textColor="@color/pw_card"
                android:textSize="@dimen/pw_ts_caption"
                tools:text="2026/06/16  周二  15:01" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_10"
            android:focusable="false"
            android:text="发现好片，一触即达"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/pw_ts_sub" />
    </LinearLayout>

    <!-- 内容区：胶囊分类 + 页面 -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="@dimen/vs_0"
        android:layout_height="@dimen/vs_0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/vs_20"
        app:layout_constraintBottom_toTopOf="@+id/pwTabBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:paddingLeft="@dimen/pw_pad"
            android:paddingRight="@dimen/pw_pad"
            app:tv_selectedItemIsCentered="false" />

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- 全局底部 Tab 栏 -->
    <LinearLayout
        android:id="@+id/pwTabBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pw_tabbar_h"
        android:background="@drawable/pw_tabbar_bg"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_10"
        android:paddingRight="@dimen/vs_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout android:id="@+id/pwTabHome" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true" android:clickable="true" android:background="@drawable/pw_btn_soft">
            <ImageView android:layout_width="@dimen/vs_50" android:layout_height="@dimen/vs_50" android:src="@drawable/pw_ic_home" app:tint="@color/pw_icon_tint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="首页" android:textColor="@color/pw_tab_tint" android:textSize="@dimen/pw_ts_caption" />
        </LinearLayout>

        <LinearLayout android:id="@+id/pwTabVod" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true" android:clickable="true" android:background="@drawable/pw_btn_soft">
            <ImageView android:layout_width="@dimen/vs_50" android:layout_height="@dimen/vs_50" android:src="@drawable/pw_ic_grid" app:tint="@color/pw_icon_tint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="分类" android:textColor="@color/pw_tab_tint" android:textSize="@dimen/pw_ts_caption" />
        </LinearLayout>

        <LinearLayout android:id="@+id/pwTabCollect" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true" android:clickable="true" android:background="@drawable/pw_btn_soft">
            <ImageView android:layout_width="@dimen/vs_50" android:layout_height="@dimen/vs_50" android:src="@drawable/pw_ic_collect" app:tint="@color/pw_icon_tint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收藏" android:textColor="@color/pw_tab_tint" android:textSize="@dimen/pw_ts_caption" />
        </LinearLayout>

        <LinearLayout android:id="@+id/pwTabHistory" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true" android:clickable="true" android:background="@drawable/pw_btn_soft">
            <ImageView android:layout_width="@dimen/vs_50" android:layout_height="@dimen/vs_50" android:src="@drawable/pw_ic_history" app:tint="@color/pw_icon_tint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="历史" android:textColor="@color/pw_tab_tint" android:textSize="@dimen/pw_ts_caption" />
        </LinearLayout>

        <LinearLayout android:id="@+id/pwTabSetting" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:focusable="true" android:clickable="true" android:background="@drawable/pw_btn_soft">
            <ImageView android:layout_width="@dimen/vs_50" android:layout_height="@dimen/vs_50" android:src="@drawable/pw_ic_setting" app:tint="@color/pw_icon_tint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="设置" android:textColor="@color/pw_tab_tint" android:textSize="@dimen/pw_ts_caption" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
