<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 竖屏：加宽面板，提示正文与按钮字号放大，深色墨字保证对比度 -->
    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:orientation="vertical"
        android:padding="@dimen/pw_pad">

        <TextView
            android:id="@+id/tipInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/vs_10"
            android:lineSpacingMultiplier="0"
            android:textAlignment="center"
            android:textColor="@color/pw_ink"
            android:textSize="@dimen/pw_ts_body"
            tools:text="提示内容" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/vs_40"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/leftBtn"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_120"
                android:layout_gravity="center"
                android:layout_marginRight="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:textColor="@color/pw_ink"
                android:textSize="@dimen/pw_ts_body"
                android:textStyle="bold"
                tools:text="确定" />

            <TextView
                android:id="@+id/rightBtn"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_120"
                android:layout_gravity="center"
                android:layout_marginLeft="@dimen/vs_10"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/vs_10"
                android:textColor="@color/pw_ink"
                android:textSize="@dimen/pw_ts_body"
                android:textStyle="bold"
                tools:text="取消" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
