<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pw_bg"
    android:orientation="vertical"
    android:paddingLeft="@dimen/pw_pad"
    android:paddingRight="@dimen/pw_pad">

    <!-- 快捷入口：7 个入口共用一套布局。
         历史/收藏/设置 由 Java 按 isPortrait() 控制：竖屏隐藏（底部 Tab 已有），横屏 TV 显示（遥控器导航需要）。
         nextFocus 焦点链按视觉顺序串联，供 TV 遥控器方向键导航。 -->
    <LinearLayout android:id="@+id/entryRow" android:layout_width="match_parent" android:layout_height="@dimen/vs_180" android:orientation="horizontal">

        <LinearLayout android:id="@+id/tvHistory" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true" android:nextFocusLeft="@id/tvSetting">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_history" app:tint="@color/pw_mint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="历史" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvLive" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_live" app:tint="@color/pw_blue" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="直播" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvSearch" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_search" app:tint="@color/pw_coral" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="搜索" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvPush" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_push" app:tint="@color/pw_blue_dark" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="推送" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvTransfer" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_transfer" app:tint="@color/pw_mint_dark" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="传输" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>

        <LinearLayout android:id="@+id/tvFavorite" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_collect" app:tint="@color/pw_coral" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="收藏" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tvSetting" android:layout_width="@dimen/vs_0" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="@dimen/vs_6" android:background="@drawable/pw_card_selector" android:gravity="center" android:orientation="vertical" android:focusable="true" android:nextFocusRight="@id/tvHistory">
            <ImageView android:layout_width="@dimen/vs_72" android:layout_height="@dimen/vs_72" android:layout_gravity="center_horizontal" android:src="@drawable/icon_setting" app:tint="@color/pw_ink2" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vs_8" android:text="设置" android:textColor="@color/pw_ink" android:textSize="@dimen/pw_ts_body" />
        </LinearLayout>
    </LinearLayout>

    <!-- 为你推荐 标题 -->
    <TextView
        android:id="@+id/recTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/vs_16"
        android:layout_marginBottom="@dimen/vs_10"
        android:text="为你推荐"
        android:textColor="@color/pw_ink"
        android:textSize="@dimen/pw_ts_section"
        android:textStyle="bold" />

    <com.owen.tvrecyclerview.widget.TvRecyclerView
        android:id="@+id/tvHotList"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vs_0"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:tv_horizontalSpacingWithMargins="@dimen/vs_16"
        app:tv_verticalSpacingWithMargins="@dimen/vs_20"
        app:tv_selectedItemIsCentered="false"
        android:visibility="gone" />
</LinearLayout>
