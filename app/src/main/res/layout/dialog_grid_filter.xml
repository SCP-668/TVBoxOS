<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/filterRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/shape_dialog_filter_bg"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="@dimen/vs_20">

        <!-- 分段式抽屉手柄：点击在半屏/全屏间切换，上拉展开、下拉回半屏 -->
        <TextView
            android:id="@+id/tvFilterHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="@drawable/pw_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_8"
            android:text="—  上拉展开 / 下拉收起  —"
            android:textColor="@color/pw_ink2"
            android:textSize="@dimen/ts_18" />

        <!-- 明确的关闭出口：TV 遥控器/鼠标点击均可关闭筛选面板 -->
        <TextView
            android:id="@+id/tvCloseFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_10"
            android:background="@drawable/pw_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:padding="@dimen/vs_10"
            android:text="✕ 关闭筛选"
            android:textColor="@color/pw_blue"
            android:textSize="@dimen/ts_22" />

        <!-- 筛选行容器：高度按内容自适应(wrap_content)，不撑满、不留大片空白。
             内容确实超出屏幕时才滚动，用 maxHeight 约束避免小屏溢出。 -->
        <ScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/filterItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>
