<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 竖屏：加宽到接近满屏，字号/按钮整体放大，深色墨字保证对比度 -->
    <LinearLayout
        android:layout_width="@dimen/vs_480"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_danmu_setting_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/pw_pad"
        android:paddingTop="@dimen/vs_40"
        android:paddingRight="@dimen/pw_pad"
        android:paddingBottom="@dimen/vs_40">

        <TextView
            android:id="@+id/confirmation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/vs_30"
            android:gravity="center"
            android:lineSpacingMultiplier="0"
            android:singleLine="true"
            android:textColor="@color/pw_ink"
            android:textSize="@dimen/ts_40"
            android:textStyle="bold"
            android:text="确定全部删除 ?" />

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/btnConfirm"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_120"
                android:layout_gravity="center"
                android:layout_margin="@dimen/vs_16"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="是"
                android:textColor="@color/pw_ink"
                android:textSize="@dimen/pw_ts_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="@dimen/vs_0"
                android:layout_height="@dimen/vs_120"
                android:layout_gravity="center"
                android:layout_margin="@dimen/vs_16"
                android:layout_weight="1"
                android:background="@drawable/button_danmu_setting"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:text="否"
                android:textColor="@color/pw_ink"
                android:textSize="@dimen/pw_ts_body"
                android:textStyle="bold" />
        </TableRow>
    </LinearLayout>
</FrameLayout>
