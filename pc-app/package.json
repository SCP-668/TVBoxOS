{
  "name": "tvbox-pc",
  "version": "1.0.0",
  "description": "TVBox PC 桌面版（Electron + 可移植 spider 内核）",
  "main": "main.js",
  "author": "TVBox community",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64",
    "pack": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.tvbox.pc",
    "productName": "TVBox PC",
    "directories": { "output": "dist" },
    "files": ["main.js", "icon.ico"],
    "extraResources": [
      { "from": "service", "to": "service", "filter": ["**/*", "!data/**"] },
      { "from": "ui", "to": "ui", "filter": ["**/*"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico",
      "artifactName": "TVBox-PC-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer.nsh"
    }
  }
}
